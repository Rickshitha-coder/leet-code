import java.util.*;

class Solution {
    public int[] deckRevealedIncreasing(int[] deck) {
        Arrays.sort(deck);
        
        Deque<Integer> dq = new ArrayDeque<>();
        
        for (int i = deck.length - 1; i >= 0; i--) {
            if (!dq.isEmpty()) {
                dq.offerFirst(dq.pollLast()); // reverse step
            }
            dq.offerFirst(deck[i]); // insert current
        }
        
        int[] result = new int[deck.length];
        int i = 0;
        for (int num : dq) {
            result[i++] = num;
        }
        
        return result;
    }
}
